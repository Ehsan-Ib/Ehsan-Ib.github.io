---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

// Cards show just the course code ("ECE 206"), not the full course name.
function courseCode(course: string): string {
  const match = course.match(/^[A-Za-z&/]+\s*\d+[A-Za-z]*/);
  return match ? match[0] : course.split('—')[0].trim();
}
---

<ul class="project-list">
  {
    projects.map((p) => (
      <li>
        <h2>
          <a href={`/projects/${p.id}/`}>{p.data.title}</a>
        </h2>
        <p class="summary">{p.data.summary}</p>
        <p class="item-meta">
          {p.data.date.toLocaleDateString('en-US', {
            month: 'short',
            year: 'numeric',
            timeZone: 'UTC',
          })}{
            p.data.course && (
              <>
                {' · '}
                {courseCode(p.data.course)}
              </>
            )
          }
          {' · '}
          {p.data.stack.join(' · ')}
        </p>
      </li>
    ))
  }
</ul>
