---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectList from '../components/ProjectList.astro';

const featured = (
  await getCollection('projects', ({ data }) => !data.draft && data.featured)
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base
  title="Ehsan Ibrahim"
  description="Ehsan Ibrahim's portfolio — systems and performance engineering projects."
>
  <SiteHeader />
  <main class="page">
    <section class="intro">
      <h1>Ehsan Ibrahim</h1>
      <p class="tagline">
        I like figuring out how cool things work and making them work better. Here are some things
        I've worked/am working on.
      </p>
    </section>

    <section>
      <h2 class="section-label">Featured projects</h2>
      <ProjectList projects={featured} />
      <p class="more-link"><a href="/projects/">all projects →</a></p>
    </section>
  </main>
</Base>
