---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectList from '../components/ProjectList.astro';

const featured = (
  await getCollection('projects', ({ data }) => !data.draft && data.featured)
)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base title="ehsan-ib" description="Ehsan's portfolio — systems and performance engineering projects.">
  <SiteHeader />
  <main class="page">
    <section class="intro">
      <h1>Ehsan</h1>
      <!-- PLACEHOLDER: replace with the real one-line self-description -->
      <p class="placeholder">[ placeholder — one-line self-description goes here ]</p>
    </section>

    <section>
      <!-- PLACEHOLDER: replace these blocks with real about copy -->
      <div class="placeholder">[ placeholder — background ]</div>
      <div class="placeholder">[ placeholder — what I'm looking for ]</div>
    </section>

    <section>
      <h2 class="section-label">Featured projects</h2>
      <ProjectList projects={featured} />
      <p class="more-link"><a href="/projects/">all projects →</a></p>
    </section>
  </main>
</Base>
